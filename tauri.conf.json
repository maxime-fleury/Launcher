{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rust Launcher",
  "version": "1.0.0",
  "identifier": "com.bunlauncher.app",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Rust Launcher", "decorations": false, "backgroundColor": "#101218", "width": 1180, "height": 780, "minWidth": 800, "minHeight": 500 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
